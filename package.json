{
  "name": "rumbo-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist-server/server.cjs",
    "build:web": "vite build",
    "start": "node dist-server/server.cjs",
    "lint": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "cap:sync": "vite build && npx cap sync android",
    "cap:android": "vite build && npx cap sync android && npx cap open android",
    "cap:open": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/cli": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/preferences": "^8.0.1",
    "@capgo/capacitor-social-login": "^8.5.11",
    "@emotion/is-prop-valid": "^1.4.0",
    "@google/genai": "^2.23.0",
    "@types/express": "^5.0.6",
    "canvas-confetti": "^1.9.3",
    "esbuild": "^0.28.2",
    "express": "^5.2.1",
    "firebase": "^11.10.0",
    "framer-motion": "^11.12.0",
    "katex": "^0.18.7",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "pdf-parse": "^2.4.5",
    "typescript": "^7.0.2",
    "vite": "^6.4.3",
    "vite-plugin-pwa": "^1.3.0"
  }
}
