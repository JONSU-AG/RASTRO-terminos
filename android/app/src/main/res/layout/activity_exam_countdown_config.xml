<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Elegir Fecha del Examen"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Configura el examen objetivo que mostrará este widget en tu pantalla de inicio."
            android:textColor="#94A3B8"
            android:textSize="13sp"
            android:layout_marginBottom="20dp" />

        <!-- Nombre del Examen -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nombre del Examen:"
            android:textColor="#E2E8F0"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/edit_exam_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1E293B"
            android:textColor="#FFFFFF"
            android:textColorHint="#64748B"
            android:hint="Ej. CEPRUNSA I FASE 2027"
            android:padding="14dp"
            android:textSize="14sp"
            android:layout_marginBottom="16dp" />

        <!-- Selector de Exámenes Predefinidos -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Exámenes Populares (Toca uno para autocompletar):"
            android:textColor="#E2E8F0"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/btn_preset_ceprunsa1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="CEPRUNSA I FASE 2027 • 05/07/2026"
                android:backgroundTint="#1E293B"
                android:textColor="#38BDF8"
                android:textSize="12sp"
                android:layout_marginBottom="6dp" />

            <Button
                android:id="@+id/btn_preset_ceprunsa2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="CEPRUNSA II FASE 2027 • 18/10/2026"
                android:backgroundTint="#1E293B"
                android:textColor="#38BDF8"
                android:textSize="12sp"
                android:layout_marginBottom="6dp" />

            <Button
                android:id="@+id/btn_preset_ordinario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ORDINARIO I FASE • 30/08/2026"
                android:backgroundTint="#1E293B"
                android:textColor="#38BDF8"
                android:textSize="12sp"
                android:layout_marginBottom="6dp" />
        </LinearLayout>

        <!-- Fecha del Examen -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Fecha Objetivo (AAAA-MM-DD):"
            android:textColor="#E2E8F0"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <EditText
                android:id="@+id/edit_exam_date"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="#1E293B"
                android:textColor="#FFFFFF"
                android:hint="2026-07-05"
                android:textColorHint="#64748B"
                android:padding="14dp"
                android:textSize="14sp"
                android:focusable="false"
                android:clickable="true" />

            <Button
                android:id="@+id/btn_pick_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Elegir Fecha 📅"
                android:backgroundTint="#0284C7"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <!-- Botón Guardar -->
        <Button
            android:id="@+id/btn_save_config"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Guardar en el Widget 🚀"
            android:backgroundTint="#10B981"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:padding="14dp"
            android:textSize="15sp" />

    </LinearLayout>
</ScrollView>
