<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_countdown_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="16dp"
    android:gravity="center_vertical">

    <!-- Header bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_calendar_vector"
            android:contentDescription="Examen"
            android:layout_marginEnd="6dp" />

        <TextView
            android:id="@+id/widget_exam_tag"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="CONTADOR DE EXAMEN"
            android:textColor="#38BDF8"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textAllCaps="true"
            android:letterSpacing="0.08" />

        <!-- Botón de Configuración de Fecha -->
        <ImageButton
            android:id="@+id/widget_btn_settings"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_settings_vector"
            android:scaleType="fitCenter"
            android:contentDescription="Elegir Fecha"
            android:padding="4dp" />
    </LinearLayout>

    <!-- Exam Name -->
    <TextView
        android:id="@+id/widget_exam_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="CEPRUNSA I FASE 2027"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_marginBottom="6dp" />

    <!-- Big Counter Box -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_exam_days"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="75"
            android:textColor="#F8FAFC"
            android:textSize="36sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-black"
            android:includeFontPadding="false" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DÍAS"
                android:textColor="#38BDF8"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PARA EL EXAMEN"
                android:textColor="#94A3B8"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Action Hint -->
    <TextView
        android:id="@+id/widget_exam_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Toca para entrenar en RASTRO 🚀 (⚙️ para cambiar fecha)"
        android:textColor="#CBD5E1"
        android:textSize="10sp"
        android:layout_marginTop="6dp"
        android:maxLines="1"
        android:ellipsize="end" />

</LinearLayout>
