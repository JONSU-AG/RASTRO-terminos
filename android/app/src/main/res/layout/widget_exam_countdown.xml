<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_countdown_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="14dp"
    android:gravity="center_vertical">

    <!-- Header bar: Tag + Settings gear -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_calendar_vector"
            android:contentDescription="Examen"
            android:layout_marginEnd="6dp" />

        <TextView
            android:id="@+id/widget_exam_tag"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="CUENTA REGRESIVA"
            android:textColor="#38BDF8"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <!-- Botón de Configuración de Fecha -->
        <ImageButton
            android:id="@+id/widget_btn_settings"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_settings_vector"
            android:scaleType="fitCenter"
            android:contentDescription="Elegir Fecha"
            android:padding="4dp" />
    </LinearLayout>

    <!-- Exam Name -->
    <TextView
        android:id="@+id/widget_exam_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="EXAMEN DE ADMISIÓN"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_marginBottom="4dp" />

    <!-- Center Content: Big Counter + Mascot Orstty Study -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Left: Days remaining -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="bottom">

            <TextView
                android:id="@+id/widget_exam_days"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="75"
                android:textColor="#F8FAFC"
                android:textSize="36sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-black"
                android:includeFontPadding="false" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="6dp"
                android:layout_marginBottom="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DÍAS"
                    android:textColor="#38BDF8"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RESTANTES"
                    android:textColor="#94A3B8"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Right: Mascota Oficial (Artyon / Orstty) -->
        <ImageView
            android:id="@+id/widget_exam_mascot"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:scaleType="fitCenter"
            android:src="@drawable/mascot_orstty_study"
            android:contentDescription="Mascota estudiando" />
    </LinearLayout>

    <!-- Action Hint Subtitle -->
    <TextView
        android:id="@+id/widget_exam_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Toca para practicar en el Simulador"
        android:textColor="#CBD5E1"
        android:textSize="10sp"
        android:layout_marginTop="4dp"
        android:maxLines="1"
        android:ellipsize="end" />

</LinearLayout>
