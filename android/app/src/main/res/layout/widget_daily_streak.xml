<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_daily_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="14dp"
    android:gravity="center_vertical">

    <!-- Header: Flame & Tag -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_flame_vector"
            android:contentDescription="Llama de racha"
            android:layout_marginEnd="6dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="RACHA DE ESTUDIO"
            android:textColor="#F59E0B"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RASTRO"
            android:textColor="#A855F7"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.06" />
    </LinearLayout>

    <!-- Main Content Row: Numbers + Mascot -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Left: Streak count + Badge -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="bottom">

                <TextView
                    android:id="@+id/widget_daily_streak_number"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1"
                    android:textColor="#FFFFFF"
                    android:textSize="36sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-black"
                    android:includeFontPadding="false" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" DÍAS"
                    android:textColor="#F59E0B"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginStart="4dp"
                    android:layout_marginBottom="4dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_daily_status_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="En progreso • Falta hoy"
                android:textColor="#F59E0B"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Right: Animated Mascot Orstty -->
        <ImageView
            android:id="@+id/widget_daily_mascot"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:scaleType="fitCenter"
            android:src="@drawable/mascot_orstty_happy"
            android:contentDescription="Mascota ORSTTY"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <!-- Action Callout Message -->
    <TextView
        android:id="@+id/widget_daily_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Resuelve una lección hoy en Aprender y asegura tu racha"
        android:textColor="#CBD5E1"
        android:textSize="11sp"
        android:lineSpacingExtra="1dp"
        android:layout_marginTop="6dp"
        android:maxLines="2"
        android:ellipsize="end" />

</LinearLayout>
