<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_weekly_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="16dp"
    android:gravity="center_vertical">

    <!-- Top: Flame & Streak Number -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="10dp">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_flame_vector"
            android:contentDescription="Racha"
            android:layout_marginEnd="6dp" />

        <TextView
            android:id="@+id/widget_streak_days"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="5 DÍAS DE RACHA"
            android:textColor="#F59E0B"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.04" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SEMANA"
            android:textColor="#94A3B8"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 7 Day Circles Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="8dp">

        <!-- Lunes -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:id="@+id/day_indicator_1"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@drawable/widget_day_active"
                android:gravity="center"
                android:text="L"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Martes -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:id="@+id/day_indicator_2"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@drawable/widget_day_active"
                android:gravity="center"
                android:text="M"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Miercoles -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:id="@+id/day_indicator_3"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@drawable/widget_day_active"
                android:gravity="center"
                android:text="M"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Jueves -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:id="@+id/day_indicator_4"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@drawable/widget_day_today"
                android:gravity="center"
                android:text="J"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Viernes -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:id="@+id/day_indicator_5"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@drawable/widget_day_inactive"
                android:gravity="center"
                android:text="V"
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Sabado -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:id="@+id/day_indicator_6"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@drawable/widget_day_inactive"
                android:gravity="center"
                android:text="S"
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Domingo -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:id="@+id/day_indicator_7"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@drawable/widget_day_inactive"
                android:gravity="center"
                android:text="D"
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

    <!-- Motivational bottom message -->
    <TextView
        android:id="@+id/widget_streak_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="¡Completa una lección hoy para no perder tu racha! 🔥"
        android:textColor="#CBD5E1"
        android:textSize="11sp"
        android:maxLines="1"
        android:ellipsize="end" />

</LinearLayout>
